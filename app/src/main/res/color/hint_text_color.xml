<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Серый цвет подсказки при фокусе, наведении и когда текст введён -->
    <item android:color="@color/yp_text_gray" android:state_focused="true" />
    <item android:color="@color/yp_text_gray" android:state_hovered="true" />
    <item android:color="@color/yp_text_gray" android:state_activated="true" />

    <!-- Чёрный цвет подсказки в покое (поле пустое и не в фокусе) -->
    <item android:color="@color/yp_black" />
</selector>
