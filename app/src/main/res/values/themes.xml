<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Базовая тема приложения -->
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основной цвет бренда -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>


        <!-- Вторичный цвет бренда -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Цвет статус‑бара -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Цвет иконок в статус‑баре:
             false = белые иконки (на тёмном фоне)
             true = тёмные иконки (на светлом фоне) -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Производная тема (можно использовать для модификаций) -->
    <style name="Theme.PlaylistMaker" parent="Base.Theme.PlaylistMaker" />
</resources>
