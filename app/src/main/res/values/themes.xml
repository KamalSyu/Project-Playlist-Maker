<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Базовая тема приложения -->
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основной цвет бренда -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Вторичный цвет бренда -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Цвет статус‑бара -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- НОВЫЕ СТРОКИ: цвета для плейлистов -->
        <item name="playlistCoverBackground">@color/white</item>
        <item name="playlistItemTextColor">@color/yp_black</item>

        <item name="playlistItemTextColorToast">#FFFFFF</item>
        <item name="toastBackgroundColor">#1A1B22</item>

        <item name="playlist_name_text_color">#000000</item>
        <item name="playlist_track_count_text_color">#AEAFB4</item>
        <item name="playlist_item_background">#FFFFFF</item>
        <item name="bottom_sheet_background">#FFFFFF</item>

        <item name="bottom_sheet_separator_color">#E6E8EB</item>

    </style>

    <style name="Theme.PlaylistMaker" parent="Base.Theme.PlaylistMaker" />
</resources>
