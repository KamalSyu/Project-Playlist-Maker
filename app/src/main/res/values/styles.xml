<?xml version="1.0" encoding="utf-8"?>
<resources>


    <style name="BackgroundHomeScreen">
        <item name="android:background">@color/yp_blue</item>
    </style>

    <style name="BackgroundSetting">
        <item name="android:background">@color/white</item>
    </style>

    <style name="BackgroundSearch">
        <item name="android:background">@color/white</item>
    </style>

    <style name="ButtonStyleHomeScreen" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@null</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/primary_text_size</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_marginRight">16dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="iconPadding">10dp</item>
        <item name="iconTint">@color/yp_black</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textFontWeight">500</item>

    </style>

    <style name="TextStyleSetting" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/standard_text_size</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:minHeight">61dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:background">@drawable/tv_selector</item>
<!--        <item name="thumbTint">@color/yp_blue</item>-->
<!--        <item name="trackTint">@drawable/switch_selector</item>-->
    </style>

    <style name="TextStyleSearch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">@dimen/standard_text_size</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_marginRight">16dp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:elevation">0dp</item>
        <item name="maxLines">1</item>
        <item name="android:inputType">text</item>
        <item name="android:background">@drawable/button_background_search</item>
        <item name="drawableTint">@color/yp_text_gray</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textColorHint">@color/yp_text_gray</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="TextStyleTopScreen" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:textSize">@dimen/primary_text_size</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginBottom">24dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:elevation">0dp</item>
        <item name="android:drawableTint">@color/yp_black</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:drawablePadding">12dp</item>

    </style>


    <style name="ResetStyleButton" >
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">28dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="RecyclerTextViewStyleSearchName" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/standard_text_size</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>

    </style>

    <style name="RecyclerTextViewStyleSearchExecutor" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/small_text_size</item>
        <item name="android:textColor">@color/yp_text_gray</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:singleLine">true</item>

    </style>

    <style name="ErrorSearch" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/error_text_size</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="NoResultateImageSearch" >
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/ic_no_results_120</item>
    </style>

    <style name="ErrorImageSearch" >
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/ic_error_120</item>
    </style>

    <style name="ButtonStyleErrorSearch" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/yp_black</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- <item name="android:background">@drawable/button_background</item>-->
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/standard_padding</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_marginLeft">134dp</item>
        <item name="android:layout_marginRight">135dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textFontWeight">500</item>

        <!-- Отступы для текста внутри кнопки -->
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>


    <style name="ButtonHistorySearch" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/yp_black</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/standard_padding</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_marginLeft">106dp</item>
        <item name="android:layout_marginRight">106dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:singleLine">true</item>

        <!-- Отступы для текста внутри кнопки -->
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="HistorySearch" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/history_text_size</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:gravity">center</item>


        <!-- Отступы для текста внутри кнопки -->
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="SearchHint" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/small_text_size</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

</resources>


