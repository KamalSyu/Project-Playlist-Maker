<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основной цвет бренда -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Вторичный цвет бренда -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Единый цвет статус‑бара -->
        <item name="android:statusBarColor">@color/purple_700</item>

        <!-- Цвет иконок в статус‑баре: false = белые иконки на тёмном фоне -->
        <item name="android:windowLightStatusBar">false</item>

        <item name="playlistItemTextColor">@color/white</item>
        <item name="playlistCoverBackground">@color/yp_black</item>

        <item name="playlistItemTextColorToast">#1A1B22</item>

        <item name="toastBackgroundColor">#FFFFFF</item>

        <item name="playlist_name_text_color">#FFFFFF</item>
        <item name="playlist_track_count_text_color">#FFFFFF</item>
        <item name="playlist_item_background">#1A1B22</item>
        <item name="bottom_sheet_background">#1A1B22</item>
        <item name="bottom_sheet_separator_color">#FFFFFF</item>

    </style>


    <style name="Theme.PlaylistMaker" parent="Base.Theme.PlaylistMaker" />
</resources>
