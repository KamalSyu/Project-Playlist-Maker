<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:pp="http://schemas.android.com/tools">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="0dp"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_mediateca"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <TextView
                android:id="@+id/textAlbumName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Текст"
                style="@style/MediatecaTextAlbumName"
                app:layout_constraintTop_toBottomOf="@id/album"
                app:layout_constraintStart_toStartOf="@+id/album"
                app:layout_constraintEnd_toEndOf="@id/album" />

            <TextView
                android:id="@+id/textSingerName"
                style="@style/MediatecaTextSingerName"
                android:text="Текст"
                app:layout_constraintTop_toBottomOf="@id/textAlbumName"
                app:layout_constraintStart_toStartOf="@+id/album"
                app:layout_constraintEnd_toEndOf="@id/album" />

            <Button
                android:id="@+id/ic_play_button"
                style="@style/MediatecaPlayButton"
                android:background="@drawable/ic_play_button"
                app:layout_constraintTop_toBottomOf="@id/textSingerName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/ic_button_plus"
                style="@style/MediatecaPluseButton"
                app:layout_constraintTop_toBottomOf="@id/textSingerName"
                app:layout_constraintStart_toStartOf="@id/textAlbumName"
                android:background="@drawable/ic_button_plus" />

            <Button
                android:id="@+id/ic_button_like"
                style="@style/MediatecaLikeButton"
                app:layout_constraintTop_toBottomOf="@id/textSingerName"
                app:layout_constraintEnd_toEndOf="@id/textAlbumName"
                android:background="@drawable/ic_button_like" />

            <TextView
                android:id="@+id/time"
                style="@style/MediatecaTime"
                android:text="0:30"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="@id/ic_play_button"
                app:layout_constraintEnd_toEndOf="@id/ic_play_button"
                app:layout_constraintTop_toBottomOf="@id/ic_play_button"
                />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/leftBorder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5"/>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/rightBorder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="16dp" />

            <TextView
                android:id="@+id/trackTimeMillisLeft"
                style="@style/TextMediatecaLeft"
                android:text="Длительность"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/time"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:id="@+id/trackTimeMillis"
                style="@style/TextMediateca"
                android:text="Длительность"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/time"
                app:layout_constraintStart_toEndOf="@id/leftBorder"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0" />

            <TextView
                android:id="@+id/collectionNameLeft"
                style="@style/TextMediatecaLeft"
                android:text="Альбом"
                app:layout_constraintTop_toBottomOf="@id/trackTimeMillisLeft"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/collectionName"
                style="@style/TextMediateca"
                android:text="Альбом"
                app:layout_constraintTop_toBottomOf="@id/trackTimeMillis"
                app:layout_constraintStart_toEndOf="@id/leftBorder"
                app:layout_constraintEnd_toEndOf="parent"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_width="0dp"
                android:gravity="end|center_vertical" />

            <TextView
                android:id="@+id/releaseDateLeft"
                style="@style/TextMediatecaLeft"
                android:text="Год"
                app:layout_constraintTop_toBottomOf="@id/collectionNameLeft"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/releaseDate"
                style="@style/TextMediateca"
                android:text="Год"
                app:layout_constraintTop_toBottomOf="@id/collectionName"
                app:layout_constraintStart_toEndOf="@id/leftBorder"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0" />

            <TextView
                android:id="@+id/primaryGenreNameLeft"
                style="@style/TextMediatecaLeft"
                android:text="Жанр"
                app:layout_constraintTop_toBottomOf="@id/releaseDateLeft"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/primaryGenreName"
                style="@style/TextMediateca"
                android:text="Жанр"
                app:layout_constraintTop_toBottomOf="@id/releaseDate"
                app:layout_constraintStart_toEndOf="@id/leftBorder"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0" />

            <TextView
                android:id="@+id/countryLeft"
                style="@style/TextMediatecaLeft"
                android:text="Страна"
                app:layout_constraintTop_toBottomOf="@id/primaryGenreNameLeft"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/country"
                style="@style/TextMediateca"
                android:text="Страна"
                app:layout_constraintTop_toBottomOf="@id/primaryGenreName"
                app:layout_constraintStart_toEndOf="@id/leftBorder"
                app:layout_constraintEnd_toEndOf="parent"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_width="0dp"
                android:gravity="end|center_vertical"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
