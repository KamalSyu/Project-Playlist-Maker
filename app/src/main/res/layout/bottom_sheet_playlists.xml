<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="505dp"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Чёрточка -->
    <ImageView
        android:layout_width="50dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/rounded_line_50_4" />

    <!-- Блок с текстом: высота 52, текст строго по центру (и по горизонтали, и по вертикали) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/playlistText"
            style="@style/text3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить в плейлист" />
    </LinearLayout>

    <!-- Кнопка: ширина формируется за счёт 0dp + отступы, высота 36, отступ снизу 24 -->
    <Button
        android:id="@+id/newPlaylistBottomSheetButton"
        style="@style/CustomButton2"
        android:layout_width="wrap_content"
        android:text="@string/new_playlist"
        android:layout_gravity="center_horizontal" />


    <!-- Список плейлистов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlistsBottomSheetRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:nestedScrollingEnabled="false" />
</LinearLayout>
