<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/playlistCover"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="fitCenter"
        android:background="?attr/playlistCoverBackground"
        android:contentDescription="@string/playlist_cover"
        android:translationZ="2dp" />

    <!-- Название плейлиста: строго слева, 12sp -->
    <TextView
        android:id="@+id/playlistName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:lineHeight="16sp"
        android:textColor="?attr/playlistItemTextColor"
        android:textStyle="normal"
        android:fontWeight="400"
        android:gravity="start"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="4dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp" />

    <!-- Количество треков: строго слева, отступ 16dp по бокам, 12sp -->
    <TextView
        android:id="@+id/playlistTrackCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:lineHeight="16sp"
        android:textColor="?attr/playlistItemTextColor"
        android:textStyle="normal"
        android:fontWeight="400"
        android:gravity="start"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="0dp"
        android:paddingEnd="0dp" />
</LinearLayout>
