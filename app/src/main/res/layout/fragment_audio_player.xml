<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- БЛОК 1: ОРИГИНАЛЬНЫЙ КОНТЕНТ АУДИОПЛЕЕРА (БЕЗ ИЗМЕНЕНИЙ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        style="@style/BackgroundAudioplayer">

        <TextView
            android:id="@+id/back"
            style="@style/TextStyleTopScreen"
            app:drawableStartCompat="@drawable/ic_back_arrow_48"
            android:layout_marginBottom="26dp"
            android:text="@string/back"/>

        <LinearLayout android:id="@+id/no_results_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="86dp"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/no_results_image"
                style="@style/NoResultateImageSearch"/>

            <TextView
                android:id="@+id/no_results_text"
                style="@style/ErrorSearch"
                android:text="@string/no_results"/>
        </LinearLayout>

        <!-- Обернули RecyclerView в ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewAudioPlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </ScrollView>
    </LinearLayout>

    <!-- БЛОК 2: OVERLAY ДЛЯ ЗАТЕМНЕНИЯ (НОВЫЙ ЭЛЕМЕНТ) -->
    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <!-- БЛОК 3: BOTTOM SHEET ДЛЯ ВЫБОРА ПЛЕЙЛИСТОВ (НОВЫЙ ЭЛЕМЕНТ) -->
    <LinearLayout
        android:id="@+id/playlists_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:orientation="vertical"
        android:background="@drawable/bottom_sheet_bg"
        app:behavior_hideable="true"
        app:behavior_peekHeight="240dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <Button
            android:id="@+id/newPlaylistButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/new_playlist"
            style="@style/Widget.Material3.Button.TextButton" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistsSelectionRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
    <Button
        android:id="@+id/add_to_playlist_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_to_playlist"
        android:layout_gravity="end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
