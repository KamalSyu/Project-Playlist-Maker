<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:pp="http://schemas.android.com/tools">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/album"
                style="@style/AlbumImageViewStyle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <TextView
                android:id="@+id/textTrackName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Текст"
                style="@style/AudioPlayerTextTrackName"
                app:layout_constraintTop_toBottomOf="@id/album"
                app:layout_constraintStart_toStartOf="@+id/album"
                app:layout_constraintEnd_toEndOf="@id/album" />

            <TextView
                android:id="@+id/textArtistName"
                style="@style/AudoPlayerTextArtistName"
                android:text="Текст"
                app:layout_constraintTop_toBottomOf="@id/textTrackName"
                app:layout_constraintStart_toStartOf="@+id/album"
                app:layout_constraintEnd_toEndOf="@id/album" />

            <ImageButton
                android:id="@+id/ic_play_button"
                style="@style/AudoPlayerPlayButton"
                app:layout_constraintTop_toBottomOf="@id/textArtistName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:enabled="false"/>

            <Button
                android:id="@+id/ic_button_plus"
                style="@style/AudioPlayerPluseButton"
                app:layout_constraintTop_toBottomOf="@id/textArtistName"
                app:layout_constraintStart_toStartOf="@id/textTrackName" />

            <Button
                android:id="@+id/ic_button_like"
                style="@style/AudoPlayerLikeButton"
                app:layout_constraintTop_toBottomOf="@id/textArtistName"
                app:layout_constraintEnd_toEndOf="@id/textTrackName" />

            <TextView
                android:id="@+id/timeTextView"
                style="@style/MediatecaTime"
                android:text="0:30"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="@id/ic_play_button"
                app:layout_constraintEnd_toEndOf="@id/ic_play_button"
                app:layout_constraintTop_toBottomOf="@id/ic_play_button"
                />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/leftBorder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5"/>


            <TextView
                android:id="@+id/trackTimeMillisLeft"
                style="@style/TextAudioPlayerLeft"
                android:text="Длительность"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/timeTextView"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:id="@+id/trackTimeMillis"
                style="@style/TextAudioPlayer"
                android:text="Длительность"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/timeTextView"
                app:layout_constraintStart_toEndOf="@id/leftBorder"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/collectionNameLeft"
                style="@style/TextAudioPlayerLeft"
                android:text="Альбом"
                app:layout_constraintTop_toBottomOf="@id/trackTimeMillisLeft"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/collectionName"
                style="@style/TextAudioPlayer"
                android:text="Альбом"
                app:layout_constraintTop_toBottomOf="@id/trackTimeMillis"
                app:layout_constraintStart_toEndOf="@id/leftBorder"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/releaseDateLeft"
                style="@style/TextAudioPlayerLeft"
                android:text="Год"
                app:layout_constraintTop_toBottomOf="@id/collectionNameLeft"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/releaseDate"
                style="@style/TextAudioPlayer"
                android:text="Год"
                app:layout_constraintTop_toBottomOf="@id/collectionName"
                app:layout_constraintStart_toEndOf="@id/leftBorder"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/primaryGenreNameLeft"
                style="@style/TextAudioPlayerLeft"
                android:text="Жанр"
                app:layout_constraintTop_toBottomOf="@id/releaseDateLeft"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/primaryGenreName"
                style="@style/TextAudioPlayer"
                android:text="Жанр"
                app:layout_constraintTop_toBottomOf="@id/releaseDate"
                app:layout_constraintStart_toEndOf="@id/leftBorder"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/countryLeft"
                style="@style/TextAudioPlayerLeft"
                android:text="Страна"
                app:layout_constraintTop_toBottomOf="@id/primaryGenreNameLeft"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/country"
                style="@style/TextAudioPlayer"
                android:text="Страна"
                app:layout_constraintTop_toBottomOf="@id/primaryGenreName"
                app:layout_constraintStart_toEndOf="@id/leftBorder"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>