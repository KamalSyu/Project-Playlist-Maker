<?xml version="1.0" encoding="utf-8"?>
<!-- Основной макет экрана поиска с улучшенной читаемостью и структурой -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BackgroundSearch"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Заголовок или кнопка возврата -->
    <TextView
        android:id="@+id/back"
        style="@style/TextStyleTopScreen"
        android:layout_marginBottom="8dp"
        android:text="@string/search"
        app:drawableStartCompat="@drawable/ic_back_arrow_48" />

    <!-- Поле поиска с кнопкой сброса -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <EditText
            android:id="@+id/search_edit_text"
            style="@style/TextStyleSearch"
            android:drawableStart="@drawable/ic_search_16"
            android:hint="@string/search"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:paddingEnd="40dp"/>

        <ImageView
            android:id="@+id/reset_button"
            style="@style/ResetStyleButton"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_delete_vector_12" />
    </FrameLayout>

    <!-- Сообщение "Нет результатов" -->
    <LinearLayout android:id="@+id/no_results_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="86dp"
        android:gravity="center"
        android:visibility="gone"
        xmlns:android="http://schemas.android.com/apk/res/android">

        <ImageView
            android:id="@+id/no_results_image"
            style="@style/NoResultateImageSearch"/>

        <TextView
            android:id="@+id/no_results_text"
            style="@style/ErrorSearch"
            android:text="@string/no_results"/>

    </LinearLayout>

    <!-- Сообщение об ошибке -->
    <LinearLayout android:id="@+id/error_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="86dp"
        android:gravity="center"
        android:visibility="gone"
        xmlns:android="http://schemas.android.com/apk/res/android">

        <ImageView
            android:id="@+id/error_image"
            style="@style/ErrorImageSearch"/>

        <TextView
            android:id="@+id/error_text"
            style="@style/ErrorSearch"
            android:text="@string/error_occurred1" />

        <Button
            android:id="@+id/refresh_button"
            style="@style/ButtonStyleErrorSearch"
            android:text="@string/update" />
    </LinearLayout>

    <!-- Список результатов поиска -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />




</LinearLayout>