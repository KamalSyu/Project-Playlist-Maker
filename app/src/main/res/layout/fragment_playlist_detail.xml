<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Затемнение фона (overlayDim) -->
    <View
        android:id="@+id/overlayDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:alpha="0"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Верхняя часть: обложка + инфо + иконки -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Фон под данными о плейлисте (светло-серый) -->
        <View
            android:id="@+id/infoBg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/light_gray_bg"
            app:layout_constraintTop_toTopOf="@id/playlistCover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/actionIconsContainer"/>

        <!-- Обложка: квадрат на всю ширину -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/playlistCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/playlist_cover"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/playlistName"
            app:layout_constraintDimensionRatio="1:1"/>

        <!-- Кнопка «Назад» -->
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back_arrow_48"
            android:contentDescription="Назад"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/black"
            app:layout_constraintTop_toTopOf="@id/playlistCover"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"/>

        <!-- Название плейлиста -->
        <TextView
            android:id="@+id/playlistName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/playlistCover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

        <!-- Год создания -->
        <TextView
            android:id="@+id/playlistYear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/playlistName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

        <!-- Длительность и кол-во треков -->
        <LinearLayout
            android:id="@+id/statsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/playlistYear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/playlistDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/playlistTrackCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Панель с ДВУМЯ иконками (без изменений) -->
        <LinearLayout
            android:id="@+id/actionIconsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/statsContainer"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp">

            <!-- Иконка 1: «Поделиться» -->
            <ImageView
                android:id="@+id/shareIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share"
                android:contentDescription="Поделиться"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/black"/>

            <Space
                android:layout_width="16dp"
                android:layout_height="wrap_content"/>

            <!-- Иконка 2: «Меню» (три точки) -->
            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_more_vert"
                android:contentDescription="Меню"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/black"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Список треков как BottomSheet (нельзя скрыть) -->
    <FrameLayout
        android:id="@+id/bottomSheetFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Чёрточка: в самом верху области треков -->
            <ImageView
                android:layout_width="50dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/rounded_line_50_4"
                android:backgroundTint="@color/white"/>

            <!-- Список треков -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tracksRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Всплывающее меню (Bottom Sheet) — без иконок, только текст -->
    <FrameLayout
        android:id="@+id/menuBottomSheetFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_skipCollapsed="false"
        >

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:background="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Краткая информация о плейлисте -->
                <TextView
                    android:id="@+id/menuPlaylistName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center_horizontal"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider"/>

                <!-- Пункт «Поделиться» (только текст) -->
                <TextView
                    android:id="@+id/menuShareItem"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Поделиться"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- Пункт «Редактировать информацию» (ТОЧЕЧНОЕ ИЗМЕНЕНИЕ) -->
                <TextView
                    android:id="@+id/menuEditItem"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Редактировать информацию"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- Пункт «Удалить плейлист» (только текст, красный цвет для акцента) -->
                <TextView
                    android:id="@+id/menuDeleteItem"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Удалить плейлист"
                    android:textColor="@android:color/holo_red_dark"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
