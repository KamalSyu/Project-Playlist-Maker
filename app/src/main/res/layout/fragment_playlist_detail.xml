<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Затемнение фона (overlay) — лежит на верхнем уровне, перекрывает всё при необходимости -->
    <View
        android:id="@+id/overlayDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:alpha="0"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Вся прокручиваемая область (только один прямой ребёнок внутри NestedScrollView) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Кнопка «Назад» -->
            <TextView
                android:id="@+id/backButton"
                style="@style/TextStyleTopScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/mediateka"
                app:drawableStartCompat="@drawable/ic_back_arrow_48"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Обложка -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/playlistCover"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:contentDescription="@string/playlist_cover"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder_312"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Rounded8dp"
                app:layout_constraintTop_toBottomOf="@id/backButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"/>

            <!-- Название -->
            <TextView
                android:id="@+id/playlistName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/cardview_shadow_end_color"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/playlistCover"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"/>

            <!-- Описание -->
            <TextView
                android:id="@+id/playlistDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/cardview_shadow_end_color"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/playlistName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"/>

            <!-- Длительность -->
            <TextView
                android:id="@+id/playlistDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/cardview_shadow_end_color"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/playlistDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"/>

            <!-- Количество треков -->
            <TextView
                android:id="@+id/playlistTrackCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/cardview_shadow_end_color"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/playlistDuration"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="4dp"/>

            <!-- Кнопки: Поделиться / Меню (горизонтальный LinearLayout) -->
            <LinearLayout
                android:id="@+id/actionButtonsContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/playlistTrackCount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Поделиться"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Меню"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BottomSheet для меню (hideable=true) -->
    <!-- ВАЖНО: лежит на том же уровне, что и NestedScrollView, а не внутри него -->
    <FrameLayout
        android:id="@+id/menuBottomSheetFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_skipCollapsed="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface">

            <TextView
                android:id="@+id/menuTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Меню"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareInMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Поделиться"
                app:layout_constraintTop_toBottomOf="@id/menuTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteInMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Удалить плейлист"
                app:layout_constraintTop_toBottomOf="@id/btnShareInMenu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- BottomSheet: список треков (не hideable) -->
    <FrameLayout
        android:id="@+id/bottomSheetFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tracksRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
