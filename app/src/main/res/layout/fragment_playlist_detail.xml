<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Вся верхняя часть (обложка, описание, кнопки) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Кнопка «Назад» -->
            <TextView
                android:id="@+id/backButton"
                style="@style/TextStyleTopScreen"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/mediateka"
                app:drawableStartCompat="@drawable/ic_back_arrow_48" />

            <!-- Обложка -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/playlistCover"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:contentDescription="@string/playlist_cover"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder_312"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Rounded8dp" />

            <!-- Название -->
            <TextView
                android:id="@+id/playlistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/cardview_shadow_end_color"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Описание -->
            <TextView
                android:id="@+id/playlistDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/cardview_shadow_end_color"
                android:textSize="16sp" />

            <!-- Длительность -->
            <TextView
                android:id="@+id/playlistDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/cardview_shadow_end_color"
                android:textSize="14sp" />

            <!-- Количество треков -->
            <TextView
                android:id="@+id/playlistTrackCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/cardview_shadow_end_color"
                android:textSize="14sp" />

            <!-- Кнопки: Поделиться / Меню -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/shareButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Поделиться" />

                <Button
                    android:id="@+id/menuButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Меню" />
            </LinearLayout>
        </LinearLayout>

        <!-- BottomSheet для меню (hideable=true) -->
        <FrameLayout
            android:id="@+id/menuBottomSheetFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            app:behavior_hideable="true"
            app:behavior_skipCollapsed="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface">

                <TextView
                    android:id="@+id/menuTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Меню"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <Button
                    android:id="@+id/btnShareInMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Поделиться"
                    style="@style/Widget.Material3.Button.TextButton"
                    app:layout_constraintTop_toBottomOf="@id/menuTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <Button
                    android:id="@+id/btnDeleteInMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Удалить плейлист"
                    style="@style/Widget.Material3.Button.TonalButton"
                    app:layout_constraintTop_toBottomOf="@id/btnShareInMenu"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Затемнение фона (overlay) — лежит на том же уровне, что и NestedScrollView и bottomSheetFrame -->
    <View
        android:id="@+id/overlayDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:alpha="0"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <!-- BottomSheet: список треков (не hideable) -->
    <FrameLayout
        android:id="@+id/bottomSheetFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tracksRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
