<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/BackgroundAudioplayer">

        <TextView
        android:id="@+id/back"
        style="@style/TextStyleTopScreen"
        app:drawableStartCompat="@drawable/ic_back_arrow_48"
        android:layout_marginBottom="26dp"
        android:text="@string/new_playlist" />

    <ImageView
        android:id="@+id/playlistCoverImage"
        android:scaleType="centerCrop"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/playlist_cover"
        android:background="@drawable/playlist_cover_border"
        android:clickable="true"
        android:focusable="true"
        style="@style/AlbumImageViewStyle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintDimensionRatio="1:1" />


    <!-- Поле описания -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/playlistDescriptionField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:boxStrokeWidth="0dp"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:hint="@string/playlist_description_hint"
            android:inputType="textMultiLine"
            android:textColor="#1A1B22"
            android:background="@drawable/text_input_outline_border"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="19dp"
        android:focusable="true"
        android:focusableInTouchMode="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Поле названия -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/playlistNameField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="170dp"
        app:boxStrokeWidth="0dp">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:hint="@string/playlist_name_hint"
            android:inputType="text"
            android:textColor="#1A1B22"
            android:background="@drawable/text_input_outline_border"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="19dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </com.google.android.material.textfield.TextInputLayout>



    <!-- Кнопка «Создать» -->
    <Button
        android:id="@+id/createPlaylistButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        android:paddingBottom="1dp"
        android:background="@drawable/button_create_playlist_background"
        android:text="@string/create_playlist"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:enabled="false"
        />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
