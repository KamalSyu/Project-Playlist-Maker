<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/white" /> <!-- цвет заливки фона -->
    <stroke
        android:width="1dp"
        android:color="#AEAFB4"
        android:dashGap="30dp"
        android:dashWidth="30dp" /> <!-- пунктирная линия: длина штриха 6dp, зазор 3dp -->
    <corners android:radius="8dp" /> <!-- радиус скругления 8dp -->
</shape>
